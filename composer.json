{
    "type": "project",
    "name": "sweetchuck/coverage-merger-cli",
    "description": "CLI tool to merge two or more coverage report files into one.",
    "keywords": [
        "phpunit",
        "coverage"
    ],
    "authors": [
        {
            "name": "Andor",
            "role": "Maintainer",
            "homepage": "https://github.com/Sweetchuck"
        }
    ],
    "homepage": "https://github.com/Sweetchuck/coverage-merger-cli",
    "support": {
        "source": "https://github.com/Sweetchuck/coverage-merger-cli",
        "issues": "https://github.com/Sweetchuck/coverage-merger-cli/issues"
    },
    "license": "GPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "sweetchuck/composer-suite": true,
            "sweetchuck/git-hooks": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "psr/log": "^3.0",
        "sweetchuck/coverage-merger": "3.x-dev",
        "symfony/console": "^7.0",
        "symfony/dependency-injection": "^7.0"
    },
    "require-dev": {
        "mikey179/vfsstream": "^1.6",
        "nuvoleweb/robo-config": "^3.0",
        "phpmd/phpmd": "^2.11",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0",
        "sweetchuck/composer-suite": "1.x-dev",
        "sweetchuck/git-hooks": "2.x-dev",
        "sweetchuck/robo-composer": "4.x-dev",
        "sweetchuck/robo-git": "4.x-dev",
        "sweetchuck/robo-phpcs": "4.x-dev",
        "sweetchuck/robo-phpmd": "4.x-dev",
        "sweetchuck/robo-phpstan": "3.x-dev",
        "symfony/error-handler": "^5.3 || ^6.0",
        "symfony/filesystem": "^7.0",
        "symfony/finder": "^7.0",
        "symfony/yaml": "^7.0"
    },
    "bin": [
        "./bin/coverage-merger"
    ],
    "autoload": {
        "psr-4": {
            "Sweetchuck\\CoverageMergerCli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sweetchuck\\CoverageMergerCli\\Tests\\": "tests/src/",
            "Sweetchuck\\CoverageMergerCli\\Tests\\Fixtures\\Case01\\": "tests/fixtures/case-01/src/",
            "Sweetchuck\\CoverageMergerCli\\Tests\\Fixtures\\Case01\\Tests\\": "tests/fixtures/case-01/tests/"
        }
    },
    "scripts": {},
    "scripts-descriptions": {},
    "extra": {
        "composer-suite": {
            "local": {
                "actions": [
                    {
                        "type": "prepend",
                        "config": {
                            "parents": [
                                "repositories"
                            ],
                            "items": {
                                "sweetchuck/coverage-merger": {
                                    "type": "path",
                                    "url": "../../sweetchuck/coverage-merger-3.x"
                                }
                            }
                        }
                    }
                ]
            }
        }
    }
}
